{
  "name": "TermoEncerramento",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Enviado",
        "Assinado"
      ],
      "default": "Rascunho"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "created_by_name": {
      "type": "string"
    },
    "auto_data_snapshot": {
      "type": "string",
      "description": "JSON snapshot dos dados autom\u00e1ticos"
    },
    "macro_schedule_snapshot": {
      "type": "string",
      "description": "JSON snapshot do cronograma macro"
    },
    "last_auto_update": {
      "type": "string",
      "description": "ISO datetime da \u00faltima atualiza\u00e7\u00e3o autom\u00e1tica"
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          },
          "action_plan": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          }
        }
      }
    },
    "final_considerations": {
      "type": "string"
    },
    "selected_adendo_id": {
      "type": "string",
      "description": "ID do adendo selecionado (sele\u00e7\u00e3o \u00fanica)"
    },
    "selected_adendos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legado: IDs dos adendos selecionados (mantido para compatibilidade)"
    },
    "selected_coordenadora_id": {
      "type": "string",
      "description": "ID da Assinatura: Coordenadora de implanta\u00e7\u00e3o"
    },
    "selected_lider_id": {
      "type": "string",
      "description": "ID da Assinatura: L\u00edder de implanta\u00e7\u00e3o"
    },
    "selected_gerente_id": {
      "type": "string",
      "description": "ID da Assinatura: Gerente de Opera\u00e7\u00f5es"
    },
    "section_overrides": {
      "type": "string",
      "description": "JSON: { fieldKey: value } \u2014 campos autom\u00e1ticos sobrescritos manualmente pelo time"
    },
    "d4sign_doc_uuid": {
      "type": "string",
      "description": "UUID do documento no D4Sign"
    },
    "d4sign_status": {
      "type": "string",
      "description": "Status da assinatura no D4Sign (enviado, assinado, cancelado)"
    },
    "d4sign_sent_at": {
      "type": "string",
      "description": "ISO datetime de quando foi enviado para assinatura"
    },
    "status_assinatura": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "assinado"
      ],
      "default": "rascunho"
    },
    "data_envio_assinatura": {
      "type": "string"
    },
    "data_assinatura": {
      "type": "string"
    },
    "link_assinatura": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "version_number"
  ]
}