{
  "name": "TermoEncerramento",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Enviado",
        "Assinado"
      ],
      "default": "Rascunho"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "created_by_name": {
      "type": "string"
    },
    "auto_data_snapshot": {
      "type": "string",
      "description": "JSON snapshot dos dados autom\u00e1ticos"
    },
    "macro_schedule_snapshot": {
      "type": "string",
      "description": "JSON snapshot do cronograma macro"
    },
    "last_auto_update": {
      "type": "string",
      "description": "ISO datetime da \u00faltima atualiza\u00e7\u00e3o autom\u00e1tica"
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          },
          "action_plan": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          }
        }
      },
      "description": "Pend\u00eancias do projeto"
    },
    "final_considerations": {
      "type": "string",
      "description": "Considera\u00e7\u00f5es finais edit\u00e1veis"
    },
    "selected_adendos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos adendos selecionados (em ordem)"
    },
    "d4sign_document_id": {
      "type": "string",
      "description": "ID do documento no D4Sign"
    },
    "status_assinatura": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "assinado"
      ],
      "default": "rascunho",
      "description": "Status da assinatura eletr\u00f4nica"
    },
    "data_envio_assinatura": {
      "type": "string",
      "description": "ISO datetime do envio para assinatura"
    },
    "data_assinatura": {
      "type": "string",
      "description": "ISO datetime da assinatura"
    },
    "link_assinatura": {
      "type": "string",
      "description": "Link de acesso ao documento para assinatura"
    }
  },
  "required": [
    "project_id",
    "version_number"
  ]
}