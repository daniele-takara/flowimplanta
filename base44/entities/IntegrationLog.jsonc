{
  "name": "IntegrationLog",
  "type": "object",
  "properties": {
    "integration_type": {
      "type": "string",
      "enum": [
        "pipedrive_cronograma"
      ],
      "description": "Tipo da integra\u00e7\u00e3o"
    },
    "source": {
      "type": "string",
      "enum": [
        "webhook",
        "manual_sync",
        "diagnostic_test"
      ],
      "description": "Origem da execu\u00e7\u00e3o"
    },
    "action": {
      "type": "string",
      "description": "A\u00e7\u00e3o executada: apply_rules, validate, test"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial_success",
        "ignored",
        "error"
      ],
      "description": "Status do processamento"
    },
    "deal_id": {
      "type": "number",
      "description": "ID do deal no Pipedrive"
    },
    "activity_id": {
      "type": "number",
      "description": "ID da activity no Pipedrive (se aplic\u00e1vel)"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto Base44 encontrado"
    },
    "project_name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "event_type": {
      "type": "string",
      "description": "Tipo do evento: change.deal, change.activity, create.activity"
    },
    "rules_loaded": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de regras carregadas"
    },
    "rules_matched": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de regras que deram match"
    },
    "phases_found": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de fases encontradas no projeto"
    },
    "activities_found": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de atividades encontradas no cronograma"
    },
    "activities_created": {
      "type": "number",
      "default": 0
    },
    "activities_updated": {
      "type": "number",
      "default": 0
    },
    "dates_filled": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de datas preenchidas"
    },
    "dates_ignored": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de datas ignoradas (j\u00e1 existiam)"
    },
    "match_errors": {
      "type": "string",
      "description": "JSON array de erros de match de fase/atividade"
    },
    "errors": {
      "type": "string",
      "description": "JSON array de erros gerais"
    },
    "request_payload": {
      "type": "string",
      "description": "JSON do payload recebido (truncado)"
    },
    "response_payload": {
      "type": "string",
      "description": "JSON do resultado retornado"
    },
    "debug_steps": {
      "type": "string",
      "description": "JSON com steps detalhados de debug: regras avaliadas, compara\u00e7\u00f5es, motivos de skip"
    },
    "duration_ms": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o do processamento em ms"
    }
  },
  "required": [
    "integration_type",
    "source",
    "status"
  ]
}