{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "permission_profile_id": {
      "type": "string",
      "description": "ID do PermissionProfile vinculado ao usu\u00e1rio"
    },
    "app_role": {
      "type": "string",
      "description": "Role legado \u2014 mantido por compatibilidade. Use permission_profile_id para RBAC."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Usu\u00e1rio ativo no sistema"
    }
  }
}