{
  "name": "SchedulePhase",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string",
      "description": "Nome da fase \u2014 deve corresponder exatamente \u00e0s fases de PHASE_ORDER em scheduleTasks.js"
    },
    "planned_start": {
      "type": "string",
      "format": "date"
    },
    "planned_end": {
      "type": "string",
      "format": "date"
    },
    "actual_start": {
      "type": "string",
      "format": "date"
    },
    "actual_end": {
      "type": "string",
      "format": "date"
    },
    "progress_percent": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "N\u00e3o iniciado",
        "Em andamento",
        "Conclu\u00eddo",
        "Atrasado",
        "Bloqueado"
      ],
      "default": "N\u00e3o iniciado"
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "phase_name"
  ]
}