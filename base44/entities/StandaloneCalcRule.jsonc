{
  "name": "StandaloneCalcRule",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Token \u00fanico de acesso p\u00fablico"
    },
    "client_name": {
      "type": "string",
      "description": "Nome da empresa/cliente"
    },
    "client_email": {
      "type": "string",
      "description": "E-mail de contato do cliente"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID alfanum\u00e9rico do cliente (extra\u00eddo do e-mail lar21@<id>.com.br)"
    },
    "implantacao_user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio de implanta\u00e7\u00e3o respons\u00e1vel"
    },
    "implantacao_user_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio de implanta\u00e7\u00e3o respons\u00e1vel (denormalizado para exibi\u00e7\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_revisao",
        "validado",
        "concluido"
      ],
      "default": "pendente"
    },
    "reviewer_notes": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es do revisor"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Nome de quem revisou"
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO datetime da \u00faltima revis\u00e3o"
    },
    "current_step": {
      "type": "number",
      "default": 1
    },
    "company_data": {
      "type": "string",
      "description": "JSON: dados da empresa"
    },
    "rule_configurations": {
      "type": "string",
      "description": "JSON: configura\u00e7\u00f5es das regras"
    },
    "overtime_rules": {
      "type": "string",
      "description": "JSON: regras de horas extras"
    },
    "break_time_rules": {
      "type": "string",
      "description": "JSON: regras de intervalos"
    },
    "night_shift_rules": {
      "type": "string",
      "description": "JSON: regras de adicional noturno"
    },
    "shift_12x36_rules": {
      "type": "string",
      "description": "JSON: regras de jornada 12x36"
    },
    "sobreaviso_rules": {
      "type": "string",
      "description": "JSON: regras de sobreaviso"
    },
    "bank_hours_rules": {
      "type": "string",
      "description": "JSON: regras de banco de horas"
    },
    "dsr_rules": {
      "type": "string",
      "description": "JSON: regras de DSR/feriados"
    },
    "other_verbs_rules": {
      "type": "string",
      "description": "JSON: outras verbas"
    },
    "timesheet_config": {
      "type": "string",
      "description": "JSON: configura\u00e7\u00e3o da folha de ponto (somatoriaFinal, abreviarLegendas)"
    }
  },
  "required": [
    "token",
    "client_name",
    "client_email"
  ]
}