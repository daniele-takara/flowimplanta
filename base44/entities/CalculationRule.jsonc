{
  "name": "CalculationRule",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado"
      ],
      "default": "rascunho"
    },
    "current_step": {
      "type": "number",
      "default": 1
    },
    "company_data": {
      "type": "string",
      "description": "JSON: dados da empresa"
    },
    "rule_configurations": {
      "type": "string",
      "description": "JSON: configura\u00e7\u00f5es das regras"
    },
    "overtime_rules": {
      "type": "string",
      "description": "JSON: regras de horas extras"
    },
    "break_time_rules": {
      "type": "string",
      "description": "JSON: regras de intervalos"
    },
    "night_shift_rules": {
      "type": "string",
      "description": "JSON: regras de adicional noturno"
    },
    "shift_12x36_rules": {
      "type": "string",
      "description": "JSON: regras de jornada 12x36"
    },
    "sobreaviso_rules": {
      "type": "string",
      "description": "JSON: regras de sobreaviso"
    },
    "bank_hours_rules": {
      "type": "string",
      "description": "JSON: regras de banco de horas"
    },
    "dsr_rules": {
      "type": "string",
      "description": "JSON: regras de DSR/feriados"
    },
    "other_verbs_rules": {
      "type": "string",
      "description": "JSON: outras verbas"
    }
  },
  "required": [
    "project_id"
  ]
}