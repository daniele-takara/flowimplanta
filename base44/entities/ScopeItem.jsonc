{
  "name": "ScopeItem",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "question_id": {
      "type": "string",
      "description": "ID can\u00f4nico da pergunta no template (ex: q001, q066). Usado para sincroniza\u00e7\u00e3o incremental."
    },
    "section": {
      "type": "string",
      "description": "Se\u00e7\u00e3o do escopo"
    },
    "order_number": {
      "type": "number"
    },
    "question": {
      "type": "string"
    },
    "best_practice": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/Boa pr\u00e1tica orientativa"
    },
    "answer": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "select",
        "boolean",
        "number",
        "date"
      ],
      "default": "text"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "_sync_meta": {
      "type": "string",
      "description": "JSON interno de sincroniza\u00e7\u00e3o: {config_hash, synced_at, synced_by, is_baseline}"
    }
  },
  "required": [
    "project_id",
    "section",
    "question"
  ]
}