{
  "name": "ScopeItem",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "description": "Se\u00e7\u00e3o do escopo",
      "enum": [
        "Informa\u00e7\u00f5es Gerais do Projeto",
        "Integra\u00e7\u00e3o Folha Sankhya",
        "Parametriza\u00e7\u00e3o C\u00e1lculos e Permiss\u00f5es",
        "Controle de Custos",
        "M\u00f3dulo de Escala",
        "M\u00f3dulo Banco de Horas",
        "M\u00f3dulo App",
        "Dispositivos de Ponto",
        "Integra\u00e7\u00f5es Externas",
        "Outros"
      ]
    },
    "order_number": {
      "type": "number"
    },
    "question": {
      "type": "string"
    },
    "best_practice": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/Boa pr\u00e1tica orientativa"
    },
    "answer": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "field_type": {
      "type": "string",
      "enum": [
        "text",
        "select",
        "boolean",
        "number",
        "date"
      ],
      "default": "text"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "section",
    "question"
  ]
}