{
  "name": "LocalSchedulePhase",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "phase_name": {
      "type": "string",
      "description": "Nome do marco/fase local"
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o no cronograma"
    },
    "planned_start": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio planejado"
    },
    "planned_end": {
      "type": "string",
      "format": "date",
      "description": "Fim planejado"
    },
    "status": {
      "type": "string",
      "enum": [
        "N\u00e3o iniciado",
        "Em andamento",
        "Conclu\u00eddo",
        "Atrasado",
        "Bloqueado",
        "Cancelado"
      ],
      "default": "N\u00e3o iniciado"
    },
    "observations": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a fase"
    },
    "responsible_general": {
      "type": "string",
      "description": "Respons\u00e1vel geral"
    },
    "responsible_leader": {
      "type": "string",
      "description": "Papel / l\u00edder respons\u00e1vel"
    },
    "is_local": {
      "type": "boolean",
      "default": true,
      "description": "Marca que a fase \u00e9 local do projeto (n\u00e3o \u00e9 do template global)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se false, fase inativada (hist\u00f3rico preservado)"
    }
  },
  "required": [
    "project_id",
    "phase_name"
  ]
}