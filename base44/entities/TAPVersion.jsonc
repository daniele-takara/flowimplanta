{
  "name": "TAPVersion",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o (1, 2, 3...)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Finalizada",
        "Enviada ao cliente"
      ],
      "default": "Rascunho"
    },
    "created_by_name": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "formato_expansao": {
      "type": "string"
    },
    "expectativa_inicio_expansao": {
      "type": "string"
    },
    "conclusao": {
      "type": "string"
    },
    "auto_data_snapshot": {
      "type": "string",
      "description": "JSON snapshot dos dados autom\u00e1ticos no momento da vers\u00e3o"
    },
    "schedule_snapshot": {
      "type": "string",
      "description": "JSON snapshot das fases macro do cronograma detalhado v1 (para se\u00e7\u00e3o 5 da TAP)"
    },
    "last_auto_update": {
      "type": "string",
      "description": "ISO datetime da \u00faltima atualiza\u00e7\u00e3o de dados autom\u00e1ticos"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "project_id",
    "version_number"
  ]
}