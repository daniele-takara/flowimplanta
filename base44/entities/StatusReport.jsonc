{
  "name": "StatusReport",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "overall_progress": {
      "type": "number",
      "description": "% progresso geral calculado pelas fases macro"
    },
    "executive_summary": {
      "type": "string"
    },
    "registered_employees": {
      "type": "number"
    },
    "recording_employees": {
      "type": "number"
    },
    "adherence_percent": {
      "type": "number"
    },
    "macro_schedule": {
      "type": "string",
      "description": "JSON das fases macro calculadas"
    },
    "usability_snapshot": {
      "type": "string",
      "description": "JSON snapshot dos dados de usabilidade"
    },
    "last_auto_update": {
      "type": "string",
      "description": "ISO datetime da \u00faltima atualiza\u00e7\u00e3o autom\u00e1tica"
    },
    "updated_by_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que atualizou"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "Alto",
              "M\u00e9dio",
              "Baixo"
            ]
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "client_pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          }
        }
      }
    },
    "internal_pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "responsible": {
            "type": "string"
          }
        }
      }
    },
    "integration_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "next_agenda": {
      "type": "string"
    },
    "next_agenda_date": {
      "type": "string",
      "format": "date"
    },
    "general_status": {
      "type": "string",
      "enum": [
        "No prazo",
        "Em risco",
        "Atrasado",
        "Conclu\u00eddo"
      ],
      "default": "No prazo"
    }
  },
  "required": [
    "project_id",
    "report_date"
  ]
}