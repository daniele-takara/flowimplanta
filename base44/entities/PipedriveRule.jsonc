{
  "name": "PipedriveRule",
  "type": "object",
  "properties": {
    "rule_type": {
      "type": "string",
      "enum": [
        "cronograma"
      ],
      "default": "cronograma",
      "description": "Tipo da regra"
    },
    "pipedrive_entidade": {
      "type": "string",
      "enum": [
        "deal",
        "activity"
      ],
      "description": "Entidade Pipedrive que dispara a regra"
    },
    "pipedrive_campo_key": {
      "type": "string",
      "description": "Campo do objeto verificado (ex: stage_id, done)"
    },
    "pipedrive_valor_disparo": {
      "type": "string",
      "description": "Valor esperado no campo (ex: 142, TRUE)"
    },
    "pipedrive_campo_identificacao": {
      "type": "string",
      "description": "Campo de identifica\u00e7\u00e3o para activity (ex: subject)"
    },
    "pipedrive_valor_identificacao": {
      "type": "string",
      "description": "Valor esperado no campo de identifica\u00e7\u00e3o (ex: nome do subject)"
    },
    "pipedrive_campo_data": {
      "type": "string",
      "description": "Campo de onde extrair a data (ex: marked_as_done_time, update_time)"
    },
    "base44_fase": {
      "type": "string",
      "description": "Fase do cronograma Base44 onde aplicar"
    },
    "base44_atividade": {
      "type": "string",
      "description": "Nome da atividade espec\u00edfica ou * para todas da fase"
    },
    "atualiza_inicio": {
      "type": "boolean",
      "default": false,
      "description": "Se deve preencher actual_start"
    },
    "atualiza_fim": {
      "type": "boolean",
      "default": false,
      "description": "Se deve preencher actual_end e marcar Conclu\u00eddo"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a regra est\u00e1 ativa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o opcional da regra"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de aplica\u00e7\u00e3o"
    }
  },
  "required": [
    "pipedrive_entidade",
    "pipedrive_campo_key",
    "pipedrive_valor_disparo",
    "base44_fase",
    "base44_atividade"
  ]
}