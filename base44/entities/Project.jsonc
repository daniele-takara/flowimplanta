{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente/Empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ do cliente (formatado: 00.000.000/0000-00)"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa na planilha de usabilidade"
    },
    "origin": {
      "type": "string",
      "description": "Origem do cliente",
      "enum": [
        "Pontotel",
        "Parceiro",
        "Indica\u00e7\u00e3o",
        "Inbound",
        "Outbound"
      ]
    },
    "mrr": {
      "type": "number",
      "description": "MRR do contrato"
    },
    "status": {
      "type": "string",
      "enum": [
        "Em aberto",
        "Em andamento",
        "Conclu\u00eddo",
        "Perdido",
        "Pausado"
      ],
      "default": "Em aberto"
    },
    "current_phase": {
      "type": "string",
      "enum": [
        "Abertura de projeto",
        "Parametriza\u00e7\u00e3o",
        "Homologa\u00e7\u00e3o",
        "Rollout",
        "Go-live",
        "Conclu\u00eddo"
      ],
      "default": "Abertura de projeto"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "planned_end_date": {
      "type": "string",
      "format": "date"
    },
    "aligned_end_date": {
      "type": "string",
      "format": "date"
    },
    "implantation_type": {
      "type": "string",
      "enum": [
        "Implanta\u00e7\u00e3o Pontotel",
        "Implanta\u00e7\u00e3o com integra\u00e7\u00e3o Sankhya",
        "Implanta\u00e7\u00e3o com integra\u00e7\u00e3o Sankhya adiada",
        "Implanta\u00e7\u00e3o Pontotel com parametriza\u00e7\u00f5es n\u00e3o finalizadas",
        "Implanta\u00e7\u00e3o com integra\u00e7\u00e3o Sankhya adiada e parametriza\u00e7\u00f5es n\u00e3o finalizadas"
      ],
      "default": "Implanta\u00e7\u00e3o Pontotel"
    },
    "contracted_employees": {
      "type": "number",
      "description": "N\u00famero de funcion\u00e1rios contratados"
    },
    "registered_employees": {
      "type": "number",
      "description": "Funcion\u00e1rios cadastrados no sistema"
    },
    "recording_employees": {
      "type": "number",
      "description": "Funcion\u00e1rios registrando ponto"
    },
    "progress_percent": {
      "type": "number",
      "description": "Progresso geral do projeto 0-100"
    },
    "sponsor_name": {
      "type": "string"
    },
    "sponsor_contact": {
      "type": "string"
    },
    "sponsor_email": {
      "type": "string",
      "description": "E-mail do patrocinador"
    },
    "sponsor_phone": {
      "type": "string",
      "description": "Telefone do patrocinador"
    },
    "project_leader_name": {
      "type": "string"
    },
    "project_leader_contact": {
      "type": "string"
    },
    "project_leader_email": {
      "type": "string",
      "description": "E-mail do l\u00edder do projeto"
    },
    "project_leader_phone": {
      "type": "string",
      "description": "Telefone do l\u00edder do projeto"
    },
    "operation_name": {
      "type": "string"
    },
    "operation_contact": {
      "type": "string"
    },
    "operation_email": {
      "type": "string",
      "description": "E-mail da opera\u00e7\u00e3o"
    },
    "operation_phone": {
      "type": "string",
      "description": "Telefone da opera\u00e7\u00e3o"
    },
    "ti_client_name": {
      "type": "string"
    },
    "ti_client_contact": {
      "type": "string"
    },
    "ti_client_email": {
      "type": "string",
      "description": "E-mail do TI cliente"
    },
    "ti_client_phone": {
      "type": "string",
      "description": "Telefone do TI cliente"
    },
    "pontotel_manager_name": {
      "type": "string"
    },
    "pontotel_manager_contact": {
      "type": "string"
    },
    "pontotel_manager_email": {
      "type": "string",
      "description": "E-mail do gerente Pontotel"
    },
    "pontotel_manager_phone": {
      "type": "string",
      "description": "Telefone do gerente Pontotel"
    },
    "pontotel_manager_id": {
      "type": "string",
      "description": "ID do User real vinculado como gerente Pontotel (fonte da verdade)"
    },
    "pontotel_analyst_name": {
      "type": "string"
    },
    "pontotel_analyst_contact": {
      "type": "string"
    },
    "pontotel_analyst_email": {
      "type": "string",
      "description": "E-mail do analista de implanta\u00e7\u00e3o"
    },
    "pontotel_analyst_phone": {
      "type": "string",
      "description": "Telefone do analista de implanta\u00e7\u00e3o"
    },
    "pontotel_analyst_id": {
      "type": "string",
      "description": "ID do User real vinculado como analista de implanta\u00e7\u00e3o (fonte da verdade)"
    },
    "contracted_modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracted_services": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observations": {
      "type": "string"
    },
    "executive_summary": {
      "type": "string",
      "description": "Resumo executivo do projeto"
    },
    "lar21": {
      "type": "string",
      "description": "Campo Lar21 (v\u00ednculo Pipedrive)"
    },
    "pipedrive_deal_id": {
      "type": "number",
      "description": "ID do deal no Pipedrive"
    },
    "pipedrive_pipeline_name": {
      "type": "string",
      "description": "Nome do pipeline Pipedrive de origem"
    },
    "drive_folder": {
      "type": "string",
      "description": "Link da pasta do Google Drive do projeto"
    },
    "schedule_anchor_dates": {
      "type": "object",
      "description": "Datas \u00e2ncora do cronograma",
      "properties": {
        "alinhamento_inicial": {
          "type": "string"
        },
        "go_live_registro_ponto": {
          "type": "string"
        },
        "agenda_fechamento_folha": {
          "type": "string"
        },
        "expansao_registro_ponto_real": {
          "type": "string"
        },
        "agenda_encerramento_projeto": {
          "type": "string"
        }
      }
    },
    "schedule_overrides": {
      "type": "object",
      "description": "JSON: { taskId: { plannedStart, plannedEnd, _origin } }"
    }
  },
  "required": [
    "name",
    "client_name"
  ]
}