{
  "name": "ScheduleActivity",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "phase_id": {
      "type": "string"
    },
    "phase_name": {
      "type": "string"
    },
    "activity_name": {
      "type": "string"
    },
    "template_id": {
      "type": "string",
      "description": "ID do ScheduleTemplate de origem (se aplic\u00e1vel)"
    },
    "depends_on_activity_id": {
      "type": "string",
      "description": "ID da atividade precedente (para depend\u00eancias)"
    },
    "responsible_role": {
      "type": "string",
      "enum": [
        "gerente_projeto",
        "analista_implantacao",
        "patrocinador",
        "lider_projeto",
        "ti",
        "operacao"
      ],
      "description": "Papel respons\u00e1vel \u2014 resolvido dinamicamente via Dados Iniciais do projeto"
    },
    "planned_start": {
      "type": "string",
      "format": "date"
    },
    "planned_end": {
      "type": "string",
      "format": "date"
    },
    "actual_start": {
      "type": "string",
      "format": "date"
    },
    "actual_end": {
      "type": "string",
      "format": "date"
    },
    "responsible_general": {
      "type": "string"
    },
    "responsible_leader": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "N\u00e3o iniciado",
        "Em andamento",
        "Conclu\u00eddo",
        "Atrasado",
        "Bloqueado",
        "Cancelado"
      ],
      "default": "N\u00e3o iniciado"
    },
    "history_observations": {
      "type": "string"
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "project_id",
    "phase_name",
    "activity_name"
  ]
}