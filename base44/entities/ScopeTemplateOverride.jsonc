{
  "name": "ScopeTemplateOverride",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "ID da pergunta do escopo (ex: q006)"
    },
    "version": {
      "type": "number",
      "description": "Vers\u00e3o incremental do override"
    },
    "prompt": {
      "type": "string",
      "description": "Texto da pergunta"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/orienta\u00e7\u00e3o da pergunta"
    },
    "type": {
      "type": "string",
      "enum": [
        "number",
        "text",
        "short_text",
        "long_text",
        "single_select",
        "multi_select",
        "boolean",
        "date",
        "date_range_text",
        "informativo"
      ],
      "description": "Tipo de resposta"
    },
    "options": {
      "type": "string",
      "description": "JSON array de op\u00e7\u00f5es (para single_select / multi_select)"
    },
    "placeholder": {
      "type": "string",
      "description": "Placeholder da resposta"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "rules": {
      "type": "string",
      "description": "JSON array de regras (conditional_visibility, etc.)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Se false, a pergunta \u00e9 desativada para novos projetos"
    },
    "changed_by": {
      "type": "string",
      "description": "Email de quem alterou"
    },
    "change_reason": {
      "type": "string",
      "description": "Justificativa da altera\u00e7\u00e3o"
    },
    "previous_snapshot": {
      "type": "string",
      "description": "JSON snapshot do estado anterior (para rollback)"
    },
    "impact_audit": {
      "type": "string",
      "description": "JSON do relat\u00f3rio de impacto gerado no momento do save"
    }
  },
  "required": [
    "question_id"
  ]
}